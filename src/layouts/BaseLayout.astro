---
import '@fontsource/radley/latin-400.css';
import '@fontsource/radley/latin-400-italic.css';
import '@fontsource/hedvig-letters-sans/latin-400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { route, type Lang } from '../lib/deck';
interface Props {
  lang: Lang;
  page: 'home' | 'gallery' | 'about' | 'card';
  title: string;
  description: string;
  id?: string;
}
const { lang, page, title, description, id } = Astro.props;
const en = lang === 'en';
const nav = [
  ['home', en ? 'The draw' : 'Le tirage'],
  ['gallery', en ? 'The cards' : 'Les cartes'],
  ['about', en ? 'About' : 'À propos'],
] as const;
const other = en ? 'fr' : 'en';
const url = (l: Lang) => new URL(route(l, page, id), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · Osho Zen Tarot</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#281d2c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={url(lang)} />
    {(['fr', 'en'] as const).map((l) => (
      <link rel="alternate" hreflang={l} href={url(l)} />
    ))}
    <meta property="og:title" content={title + ' · Osho Zen Tarot'} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">
      {en ? 'Skip to content' : 'Aller au contenu'}
    </a>
    <header class="mast">
      <div class="wrap mast-inner">
        <a class="brand" href={route(lang, 'home')}>
          <Icon name="sun" size={29} />
          <span>
            Osho Zen <i>Tarot</i>
          </span>
        </a>
        <nav aria-label={en ? 'Main navigation' : 'Navigation principale'}>
          {nav.map(([p, label]) => (
            <a
              href={route(lang, p)}
              aria-current={
                p === page || (p === 'gallery' && page === 'card')
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="languages" aria-label={en ? 'Language' : 'Langue'}>
          {(['fr', 'en'] as const).map((l) =>
            l === lang ? (
              <span
                aria-current="true"
                aria-label={l === 'fr' ? 'Français' : 'English'}
              >
                {l.toUpperCase()}
              </span>
            ) : (
              <a
                data-switch-lang
                href={route(other, page, id)}
                lang={l}
                hreflang={l}
                aria-label={l === 'fr' ? 'Français' : 'English'}
              >
                {l.toUpperCase()}
              </a>
            ),
          )}
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap foot-inner">
        <a class="brand" href={route(lang, 'home')}>
          <Icon name="sun" size={24} />
          <span>
            Osho Zen <i>Tarot</i>
          </span>
        </a>
        <a href={route(lang, 'about')}>
          {en ? 'About the project' : 'À propos du projet'}
        </a>
      </div>
    </footer>
  </body>
</html>
