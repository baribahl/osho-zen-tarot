---

<svg class="sky" aria-hidden="true" viewBox="0 0 570 390" fill="none">
  <g stroke="currentColor" stroke-width=".75">
    <ellipse
      cx="283"
      cy="201"
      rx="219"
      ry="102"
      transform="rotate(-24 283 201)"
    />
    <ellipse
      cx="283"
      cy="201"
      rx="240"
      ry="130"
      transform="rotate(-24 283 201)"
      stroke-dasharray="1 6"
    />
    <circle cx="286" cy="188" r="154" stroke-dasharray="40 10 1 9 79 800" />
  </g>
  <g class="stars" fill="currentColor">
    {stars.map(([x, y, r]) => (
      <path
        transform={`translate(${x} ${y}) scale(${r})`}
        d="M0-1Q.1-.12 1 0 .13.12 0 1-.12.12-1 0-.1-.12 0-1Z"
      />
    ))}
  </g>
</svg>
